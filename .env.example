# Licensing. Copy to .env and fill in real values.
#
# .env is gitignored; .env.example is not, and must never hold real values.
#
# IMPORTANT: these are injected into the panel bundle at build time and are
# therefore readable by anyone who has the packaged .zxp. Keeping them out of
# this repository limits exposure - it does not make them secret. Server-side
# checks are what actually protect the endpoint.

VITE_LICENSE_ENDPOINT=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
VITE_LICENSE_KEY=REPLACE_WITH_SHARED_KEY
